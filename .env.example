# CloakPay environment. Copy to .env.local and fill in. Never commit the real file.

# ── Database ────────────────────────────────────────────────────────────────
# Neon connection string for the cloakpay database. Server-side only.
DATABASE_URL="postgresql://user:password@host/cloakpay?sslmode=require"

# ── Sessions ────────────────────────────────────────────────────────────────
# 32 random bytes, base64. Generate with: openssl rand -base64 32
SESSION_SECRET=""

# ── Application origin ──────────────────────────────────────────────────────
# Used for OAuth redirect URIs, payment links and QR codes. Must match the
# origin you registered with Google and X, exactly, including the port.
APP_URL="http://localhost:3200"

# ── Google (OAuth 2.0 web application) ──────────────────────────────────────
# Authorised redirect URI to register:
#   <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── X (OAuth 1.0a by default) ───────────────────────────────────────────────
# Callback URL to register in the X developer portal:
#   <APP_URL>/api/auth/x/callback
# X no longer lets this app read `GET /2/users/me` with an OAuth 2.0 user token
# (403, after a successful token exchange) while it still accepts an OAuth 1.0a
# user token for the same endpoint and the same app, so sign-in runs on 1.0a.
# These are the app's "API Key" and "API Key Secret" from the X portal.
X_CONSUMER_KEY=""
X_CONSUMER_SECRET=""

# Optional: "1" (default) or "2". Set to 2 to sign in with OAuth 2.0 and PKCE
# instead, which needs the pair below and is the flow to use again if X grants
# the app OAuth 2.0 user-context access.
# X_OAUTH_VERSION="1"

# Only read when X_OAUTH_VERSION=2. X authenticates that token exchange with
# HTTP Basic, so the client secret is needed, not just the client id.
X_CLIENT_ID=""
X_CLIENT_SECRET=""

# ── Elysium (Kinetiq) testnet ───────────────────────────────────────────────
# Verified: eth_chainId returns 0x185d9 and eth_call confirms the BN254
# precompiles. See `npm run chain:check`.
ELYSIUM_RPC_URL="https://testnet-rpc.elysium.kinetiq.xyz"
ELYSIUM_CHAIN_ID="99801"

# The same two values, exposed to the browser because the wallet signs and
# broadcasts client-side. Both are public information.
NEXT_PUBLIC_ELYSIUM_RPC_URL="https://testnet-rpc.elysium.kinetiq.xyz"
NEXT_PUBLIC_ELYSIUM_CHAIN_ID="99801"
NEXT_PUBLIC_EXPLORER_URL="https://elysium.kinetiq.xyz/testnet-explorer"

# ── Contract deployment (only needed for `npm run chain:deploy`) ────────────
# An account that already holds testnet HYPE. CloakPay never generates or funds
# one for you, and will not record a deployment without it.
DEPLOYER_PRIVATE_KEY=""
# Optional: reuse an existing verifier instead of deploying a new one. There is
# one verifier per circuit (`withdraw.circom` and `transfer.circom`), so they are
# separate variables; leaving both unset deploys new ones.
WITHDRAW_VERIFIER_ADDRESS=""
TRANSFER_VERIFIER_ADDRESS=""

# Optional: where the Groth16 proving artifacts are served from. `/zk` is what
# `public/zk` is published at and is the right answer in a browser. It is only
# ever set to something else by a harness that runs the client outside a browser,
# or by a deployment that serves the artifacts from a CDN.
# NEXT_PUBLIC_ZK_PATH="/zk"
