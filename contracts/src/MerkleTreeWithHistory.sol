pragma solidity 0.8.28;

import {PoseidonT3} from "./vendor/PoseidonT3.sol";

/// @title Incremental Merkle tree over Poseidon, with root history.
/// @notice One tree instance exists per denomination, so a note deposited at
///         1 HYPE can never be withdrawn against the 10 HYPE tree: the root is
///         only ever registered as known inside the tree that produced it.
///
/// Must agree exactly with `src/protocol/merkle.ts` and
/// `circuits/lib/merkleProof.circom`.
library MerkleTreeWithHistory {
    using PoseidonT3 for uint256[2];

    struct Tree {
        uint32 leafCount;
        uint256 currentRoot;
        /// level (as uint256) => the most recently filled subtree at that level
        mapping(uint256 => uint256) filledSubtrees;
        /// root => whether this root was ever the tree's root
        mapping(uint256 => bool) knownRoot;
    }

    function hashPair(uint256 left, uint256 right) internal pure returns (uint256) {
        return PoseidonT3.hash([left, right]);
    }

    /// @notice The default (all-zero) subtree hash at every height up to 32.
    ///
    /// These are FIXED constants: `Poseidon(0,0)` and its iterates never change
    /// for a given curve. They are hardcoded rather than computed for two
    /// reasons — it costs nothing at deploy time, and calling the inlined
    /// Poseidon assembly from a constructor miscompiles under solc 0.8.28
    /// (the contract deploys with a truncated runtime).
    ///
    /// Generated by `src/protocol/merkle.ts:defaultHashes(32)`. The test
    /// `test_zero_hashes_are_the_poseidon_fixed_point` re-derives them through
    /// runtime Poseidon, so a drift is caught rather than silently deployed.
    function zeroTable() internal pure returns (uint256[33] memory z) {
        z = [
        0, // zeros[0]
        14744269619966411208579211824598458697587494354926760081771325075741142829156, // zeros[1]
        7423237065226347324353380772367382631490014989348495481811164164159255474657, // zeros[2]
        11286972368698509976183087595462810875513684078608517520839298933882497716792, // zeros[3]
        3607627140608796879659380071776844901612302623152076817094415224584923813162, // zeros[4]
        19712377064642672829441595136074946683621277828620209496774504837737984048981, // zeros[5]
        20775607673010627194014556968476266066927294572720319469184847051418138353016, // zeros[6]
        3396914609616007258851405644437304192397291162432396347162513310381425243293, // zeros[7]
        21551820661461729022865262380882070649935529853313286572328683688269863701601, // zeros[8]
        6573136701248752079028194407151022595060682063033565181951145966236778420039, // zeros[9]
        12413880268183407374852357075976609371175688755676981206018884971008854919922, // zeros[10]
        14271763308400718165336499097156975241954733520325982997864342600795471836726, // zeros[11]
        20066985985293572387227381049700832219069292839614107140851619262827735677018, // zeros[12]
        9394776414966240069580838672673694685292165040808226440647796406499139370960, // zeros[13]
        11331146992410411304059858900317123658895005918277453009197229807340014528524, // zeros[14]
        15819538789928229930262697811477882737253464456578333862691129291651619515538, // zeros[15]
        19217088683336594659449020493828377907203207941212636669271704950158751593251, // zeros[16]
        21035245323335827719745544373081896983162834604456827698288649288827293579666, // zeros[17]
        6939770416153240137322503476966641397417391950902474480970945462551409848591, // zeros[18]
        10941962436777715901943463195175331263348098796018438960955633645115732864202, // zeros[19]
        15019797232609675441998260052101280400536945603062888308240081994073687793470, // zeros[20]
        11702828337982203149177882813338547876343922920234831094975924378932809409969, // zeros[21]
        11217067736778784455593535811108456786943573747466706329920902520905755780395, // zeros[22]
        16072238744996205792852194127671441602062027943016727953216607508365787157389, // zeros[23]
        17681057402012993898104192736393849603097507831571622013521167331642182653248, // zeros[24]
        21694045479371014653083846597424257852691458318143380497809004364947786214945, // zeros[25]
        8163447297445169709687354538480474434591144168767135863541048304198280615192, // zeros[26]
        14081762237856300239452543304351251708585712948734528663957353575674639038357, // zeros[27]
        16619959921569409661790279042024627172199214148318086837362003702249041851090, // zeros[28]
        7022159125197495734384997711896547675021391130223237843255817587255104160365, // zeros[29]
        4114686047564160449611603615418567457008101555090703535405891656262658644463, // zeros[30]
        12549363297364877722388257367377629555213421373705596078299904496781819142130, // zeros[31]
        21443572485391568159800782191812935835534334817699172242223315142338162256601 // zeros[32]
        ];
    }

    /// @notice The default subtree hashes for a tree of the given height.
    function defaultHashes(uint32 levels) internal pure returns (uint256[] memory zeros) {
        require(levels <= 32, "MerkleTreeWithHistory: unsupported height");
        uint256[33] memory table = zeroTable();
        zeros = new uint256[](uint256(levels) + 1);
        for (uint256 i = 0; i <= levels; i++) {
            zeros[i] = table[i];
        }
    }

    function init(Tree storage self, uint32 levels, uint256[] memory zeros) internal {
        self.currentRoot = zeros[levels];
        self.knownRoot[zeros[levels]] = true;
        for (uint256 i = 0; i < levels; i++) {
            self.filledSubtrees[i] = zeros[i];
        }
    }

    /// @notice Appends a leaf and returns its index.
    function insert(
        Tree storage self,
        uint256 leaf,
        uint32 levels,
        uint256[] memory zeros
    ) internal returns (uint32 index) {
        uint32 count = self.leafCount;
        require(uint256(count) < (uint256(1) << levels), "MerkleTreeWithHistory: tree is full");
        index = count;

        uint256 current = leaf;
        uint256 cursor = uint256(count);
        for (uint256 level = 0; level < levels; level++) {
            if (cursor % 2 == 0) {
                self.filledSubtrees[level] = current;
                current = hashPair(current, zeros[level]);
            } else {
                current = hashPair(self.filledSubtrees[level], current);
            }
            cursor /= 2;
        }

        self.leafCount = count + 1;
        self.currentRoot = current;
        self.knownRoot[current] = true;
    }

    function isKnownRoot(Tree storage self, uint256 root) internal view returns (bool) {
        return self.knownRoot[root];
    }
}
